# --- mail (Gmail IMAP + app password; requires 2FA on the account) -----------
MAIL_USER=
MAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# INBOX, or [Gmail]/Deliveries if you add a Gmail filter for courier senders
MAIL_FOLDER=INBOX
IMAP_SEARCH=newer_than:7d -category:promotions -category:social -in:spam
LOOKBACK_DAYS=7

# --- schedule ---------------------------------------------------------------
POLL_INTERVAL_MINUTES=60
MAX_MAILS_PER_RUN=50

# --- parsing ----------------------------------------------------------------
PARSER_LANGUAGES=he,en
DEFAULT_COUNTRY=IL
REVIEW_MIN_CONFIDENCE=0.7

# --- calendar ---------------------------------------------------------------
# service_account (default) or oauth
CALENDAR_AUTH=service_account
# Calendar ID from Google Calendar -> Settings -> "Calendar ID"
CALENDAR_ID=
CALENDAR_NAME=Deliveries
DELIVERED_RETENTION_DAYS=7
GOOGLE_SA_FILE=/secrets/service-account.json
# OAuth fallback only
GOOGLE_CREDENTIALS_FILE=/secrets/credentials.json
GOOGLE_TOKEN_FILE=/secrets/token.json

# --- geo (off by default: nothing leaves the Pi) ----------------------------
GEOCODER=none
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=delivery-sync/1.0 (you@example.com)
GEOCODE_MIN_CONFIDENCE=0.6

# --- model tier (post-v1, off) ----------------------------------------------
MODEL_ENABLED=0
MODEL_PATH=/data/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
MODEL_THREADS=3
MODEL_CTX=2048
MODEL_TIMEOUT=300
MODEL_MAX_CALLS_PER_RUN=5
MODEL_MIN_FREE_MB=1400

# --- runtime ----------------------------------------------------------------
DRY_RUN=1
UI_ENABLED=1
UI_PORT=8099
UI_USER=admin
UI_PASSWORD=
LOG_LEVEL=INFO
